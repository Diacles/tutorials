<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.todolist">
        <div class="d-inline-block border p-2 m-2">
            <input class="form-control mb-3" type="text" placeholder="Add a todo" t-on-keyup="ev => addTodo(ev)"/>
            <!-- <input class="form-control mb-3" type="text" placeholder="Add a todo" t-on-keyup="ev => addTodo(ev)" t-ref="input"/> -->
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <p t-att-class="{'text-muted text-decoration-line-through': todo.isCompleted}"><t t-esc="todo.id"/>. <t t-esc="todo.description"/></p>
            </t>
        </div>
    </t>
</templates>